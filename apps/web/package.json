{
  "name": "@taskwish/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:cli": "bun run stage:create-project",
    "stage:create-project": "bun scripts/stage-create-project.ts",
    "build": "next build",
    "build:dependencies": "turbo build --filter=@taskwish/console...",
    "build:cloudflare": "bun run build:dependencies && opennextjs-cloudflare build",
    "preview": "bun run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "bun run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:taskwish": "bun run build:cloudflare && wrangler deploy --config wrangler.taskwish.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@taskwish/console": "workspace:*",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.152.0"
  }
}
