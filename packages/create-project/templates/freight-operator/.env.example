TW_OPEN_AI_KEY=
OPENAI_MODEL=gpt-6-astra
# Scanned PDFs: opt in to sending documents to Firecrawl Parse for OCR.
ANYDOC_OCR=off
FIRECRAWL_API_KEY=

# OAuth 2.0 access token with Gmail read-only access.
GMAIL_ACCESS_TOKEN=

# CustomerFusion and Order Creation access are required.
MCLEOD_BASE_URL=https://api.mcleodsoftware.com/ordercreation-sandbox
# Full Authorization header value supplied by McLeod, including any required scheme.
MCLEOD_AUTHORIZATION=
MCLEOD_API_KEY=
MCLEOD_TENANT=2
MCLEOD_FUSION_PROFILE=

# Optional stable Console/operator API key. Otherwise generated at startup.
TW_API_KEY=
PORT=0
