{
  "name": "@taskwish/create-project",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.3",
  "dependencies": {
    "@taskwish/skill": "^0.0.1",
    "@taskwish/terminal": "^0.0.1",
    "@taskwish/wind": "^0.0.1",
    "taskwish": "^0.0.9"
  },
  "description": "Create a fresh TypeScript TaskWish project",
  "license": "Elastic-2.0",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "create-taskwish-project": "./dist/create-taskwish-project.mjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "bun run check-skill && bun run check-template-versions && tsc --noEmit",
    "test": "bun run check-skill && bun run check-template-versions && bun test src/**/*.test.ts templates/*/src/**/*.test.ts",
    "build": "bun run sync-skill && bun run sync-template-versions && bun ../../scripts/build-package.ts && bun run build-cli",
    "build-cli": "bun scripts/build-cli.ts",
    "build-cli:platforms": "bun scripts/build-cli.ts --platforms",
    "check-skill": "bun scripts/sync-skill.ts --check",
    "check-template-versions": "bun scripts/sync-template-versions.ts --check",
    "sync-skill": "bun scripts/sync-skill.ts",
    "sync-template-versions": "bun scripts/sync-template-versions.ts",
    "start": "bun create-taskwish-project.ts"
  },
  "type": "module",
  "devDependencies": {
    "@taskwish/bare": "^0.0.1",
    "@types/bun": "^1.3.14",
    "scriptc": "^0.0.31",
    "typescript": "^5.9.2"
  }
}
