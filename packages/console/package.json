    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.563.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-jsx-parser": "^2.4.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
