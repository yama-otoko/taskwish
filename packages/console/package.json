{
  "name": "@taskwish/console",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.2",
  "description": "Console UI for TaskWish nodes",
  "license": "Elastic-2.0",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts"
    },
    "./react": {
      "source": "./src/react.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs",
      "types": "./dist/react.d.ts"
    },
    "./styles.css": "./src/styles.generated.css",
    "./index.html": {
      "source": "./src/index.html",
      "default": "./src/index.html"
    }
  },
  "taskwish": {
    "htmlSource": "./src/index.html"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "bun ../../scripts/build-package.ts"
  },
  "dependencies": {
