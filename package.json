{
  "name": "@taskwish/monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "license": "Elastic License 2.0",
  "scripts": {
    "build": "turbo build",
    "dev:web": "bun --cwd apps/web dev",
    "stage:create-project": "bun run --cwd packages/create-project build-cli:platforms && bun run --cwd apps/web stage:create-project"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.21",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "turbo": "^2.5.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "arktype": "^2.1.29"
  },
  "overrides": {
    "linkify-it": "5.0.2"
  }
}
